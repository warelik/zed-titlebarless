+    fn probe_script(&self, allow_daemon_start: bool) -> Result<String> {
+        self.validate()?;
+        let program = ShellKind::Posix.try_quote(&self.program)
+            .context("cannot quote original shpool client")?;
+        let socket = ShellKind::Posix.try_quote(&self.socket)
