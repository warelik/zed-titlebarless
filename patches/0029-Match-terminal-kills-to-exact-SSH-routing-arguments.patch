Subject: [PATCH 29/90] Match terminal kills to exact SSH routing arguments


diff --git a/crates/sidebar/src/sidebar.rs b/crates/sidebar/src/sidebar.rs
index 16ebdb5d10..df7cd20a88 100644
--- a/crates/sidebar/src/sidebar.rs
+++ b/crates/sidebar/src/sidebar.rs
@@ -707,6 +707,21 @@ fn workspace_menu_worktree_labels(
         .collect()
 }
 
+fn same_terminal_remote_connection(
+    left: Option<&RemoteConnectionOptions>,
+    right: Option<&RemoteConnectionOptions>,
+) -> bool {
+    if !same_remote_connection_identity(left, right) {
+        return false;
+    }
+    match (left, right) {
+        (Some(RemoteConnectionOptions::Ssh(left)), Some(RemoteConnectionOptions::Ssh(right))) => {
+            left.args == right.args
+        }
+        _ => true,
+    }
+}
+
 fn apply_worktree_label_mode(
     mut worktrees: Vec<ThreadItemWorktreeInfo>,
     mode: AgentThreadWorktreeLabel,
@@ -5467,7 +5482,7 @@ impl Sidebar {
         cx: &App,
     ) -> Option<Entity<project::Project>> {
         self.find_workspace_in_current_window(cx, |workspace, cx| {
-            same_remote_connection_identity(
+            same_terminal_remote_connection(
                 workspace
                     .read(cx)
                     .project()
diff --git a/crates/sidebar/src/sidebar_tests.rs b/crates/sidebar/src/sidebar_tests.rs
index 7a50ce17b6..3ca324313f 100644
--- a/crates/sidebar/src/sidebar_tests.rs
+++ b/crates/sidebar/src/sidebar_tests.rs
@@ -17391,3 +17391,30 @@ async fn test_stock_active_entry_not_synced_from_agent_panel_when_not_in_agent_p
         "Sidebar active_entry should remain None on startup when in_agent_panel is false"
     );
 }
+
+#[test]
+fn test_terminal_remote_connection_match_distinguishes_ssh_arguments() {
+    use remote::{SshConnectionOptions, SshConnectionHost};
+
+    let connection = |args: &[&str]| {
+        RemoteConnectionOptions::Ssh(SshConnectionOptions {
+            host: SshConnectionHost::from("example.com"),
+            username: Some("developer".into()),
+            port: Some(22),
+            args: Some(args.iter().map(|arg| (*arg).to_string()).collect()),
+            ..Default::default()
+        })
+    };
+    let persisted = connection(&["-F", "work.conf"]);
+    let same_endpoint = connection(&["-F", "work.conf"]);
+    let different_endpoint = connection(&["-F", "personal.conf"]);
+
+    assert!(same_terminal_remote_connection(
+        Some(&persisted),
+        Some(&same_endpoint)
+    ));
+    assert!(!same_terminal_remote_connection(
+        Some(&persisted),
+        Some(&different_endpoint)
+    ));
+}
