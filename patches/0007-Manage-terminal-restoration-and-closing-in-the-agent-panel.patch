+                .update(cx, |s, cx| s.save(metadata.clone(), cx));
+        });
+
+        panel.update_in(&mut cx, |panel, window, cx| {
+            panel.test_terminal_spawn_gate = Some(spawn_gate);
+            panel.restore_terminal(
+                metadata.clone(),
+                true,
+                AgentThreadSource::AgentPanel,
+                None,
+                window,
+                cx,
+            );
+        });
