+                project_group_key: ProjectGroupKey::new(Some(remote_connection), main_paths),
+            },
+            window,
+            cx,
+        );
+    });
+    cx.run_until_parked();
+
+    cx.update(|_, cx| {
+        assert!(
+            TerminalThreadMetadataStore::global(cx)
+                .read(cx)
+                .entry(terminal_id)
+                .is_some(),
+            "missing project must refuse close and retain terminal metadata"
+        );
+    });
+}
