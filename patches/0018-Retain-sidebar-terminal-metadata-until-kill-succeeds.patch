From 87ae88b05d8ee6fc8baf5c58bf29fad0037186f4 Mon Sep 17 00:00:00 2001
From: Codex Repair <codex-repair@example.invalid>
Date: Sat, 17 Oct 2026 03:19:48 +0000
Subject: [PATCH] Retain sidebar terminal metadata until session kill succeeds

---
 crates/sidebar/src/sidebar.rs       | 53 +++++++++++++++++++++++------
 crates/sidebar/src/sidebar_tests.rs | 29 ++++++++++++++--
 2 files changed, 69 insertions(+), 13 deletions(-)

diff --git a/crates/sidebar/src/sidebar.rs b/crates/sidebar/src/sidebar.rs
index 2bca37b..9a075cd 100644
--- a/crates/sidebar/src/sidebar.rs
+++ b/crates/sidebar/src/sidebar.rs
@@ -5286,6 +5286,26 @@ impl Sidebar {
         .map(|workspace| workspace.read(cx).project().clone())
     }
 
+    fn show_terminal_close_error(&self, terminal_id: TerminalId, cx: &mut App) {
+        let Some(multi_workspace) = self.multi_workspace.upgrade() else {
+            return;
+        };
+        let workspace = multi_workspace.read(cx).workspace().clone();
+        workspace.update(cx, |workspace, cx| {
+            struct CloseTerminalErrorToast;
+            workspace.show_toast(
+                Toast::new(
+                    NotificationId::unique::<CloseTerminalErrorToast>(),
+                    format!(
+                        "Failed to stop terminal session {terminal_id}; close it again to retry"
+                    ),
+                )
+                .autohide(),
+                cx,
+            );
+        });
+    }
+
     fn close_terminal_entry(
         &mut self,
         metadata: &TerminalThreadMetadata,
@@ -5324,20 +5344,33 @@ impl Sidebar {
                 }
             };
             if let Some(project) = project {
-                project
-                    .update(cx, |project, cx| {
-                        project.kill_persistent_terminal_session(session_name, cx)
-                    })
-                    .detach_and_log_err(cx);
+                let kill = project.update(cx, |project, cx| {
+                    project.kill_persistent_terminal_session(session_name, cx)
+                });
+                cx.spawn(async move |this, cx| match kill.await {
+                    Ok(()) => {
+                        cx.update(|cx| {
+                            if let Some(store) = TerminalThreadMetadataStore::try_global(cx) {
+                                store.update(cx, |store, cx| store.delete(terminal_id, cx));
+                            }
+                        });
+                    }
+                    Err(error) => {
+                        log::error!(
+                            "failed to kill persistent terminal session for terminal {terminal_id}: {error:#}"
+                        );
+                        this.update(cx, |this, cx| {
+                            this.show_terminal_close_error(terminal_id, cx);
+                        })
+                        .ok();
+                    }
+                })
+                .detach();
             } else {
                 log::warn!(
                     "no open project available to kill persistent terminal session for terminal {terminal_id}"
                 );
-            }
-            if let Some(store) = TerminalThreadMetadataStore::try_global(cx) {
-                store.update(cx, |store, cx| {
-                    store.delete(terminal_id, cx);
-                });
+                self.show_terminal_close_error(terminal_id, cx);
             }
         }
 
diff --git a/crates/sidebar/src/sidebar_tests.rs b/crates/sidebar/src/sidebar_tests.rs
index 283219f..9b0f38b 100644
--- a/crates/sidebar/src/sidebar_tests.rs
+++ b/crates/sidebar/src/sidebar_tests.rs
@@ -4600,7 +4600,7 @@ async fn test_closing_active_agent_panel_terminal_activates_neighbor(cx: &mut Te
 }
 
 #[gpui::test]
-async fn test_close_terminal_entry_on_closed_workspace_kills_session_and_deletes_metadata(
+async fn test_failed_close_terminal_entry_retains_metadata_until_session_kill_succeeds(
     cx: &mut TestAppContext,
 ) {
     let main_project = init_test_project_with_agent_panel("/main-project", cx).await;
@@ -4612,6 +4612,7 @@ async fn test_close_terminal_entry_on_closed_workspace_kills_session_and_deletes
     let terminal_id = TerminalId::new();
     let session_name = terminal_id.session_name();
     fake.add_session(&session_name);
+    fake.state.lock().kill_error = Some("connection lost".into());
 
     let main_paths = PathList::new(&[PathBuf::from("/main-project")]);
     let closed_worktree_paths = PathList::new(&[PathBuf::from("/worktrees/feature-a")]);
@@ -4674,7 +4675,29 @@ async fn test_close_terminal_entry_on_closed_workspace_kills_session_and_deletes
     assert_eq!(
         fake.kill_history(),
         vec![session_name.clone()],
-        "closing terminal on closed workspace must kill persistent session"
+        "closing terminal on closed workspace must try to kill its persistent session"
+    );
+    assert!(fake.has_session(&session_name));
+    cx.update(|_, cx| {
+        assert!(
+            TerminalThreadMetadataStore::global(cx)
+                .read(cx)
+                .entry(terminal_id)
+                .is_some(),
+            "failed kill must retain metadata so closing can be retried"
+        );
+    });
+
+    fake.state.lock().kill_error = None;
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.close_terminal(&terminal_metadata, &terminal_workspace, window, cx);
+    });
+    cx.run_until_parked();
+
+    assert_eq!(
+        fake.kill_history(),
+        vec![session_name.clone(), session_name.clone()],
+        "retrying close must retry the persistent session kill"
     );
     assert!(!fake.has_session(&session_name));
     cx.update(|_, cx| {
@@ -4683,7 +4706,7 @@ async fn test_close_terminal_entry_on_closed_workspace_kills_session_and_deletes
                 .read(cx)
                 .entry(terminal_id)
                 .is_none(),
-            "metadata must be deleted after close on closed workspace"
+            "metadata must be deleted only after the session kill succeeds"
         );
     });
 }
-- 
