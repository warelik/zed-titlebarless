From 02bd020a84905c21e67d80a5bd508b3e1c4a6175 Mon Sep 17 00:00:00 2001
From: warelik <warelik@users.noreply.github.com>
Date: Sun, 11 Oct 2026 16:22:53 +0300
Subject: [PATCH 6/7] Add agent.threads_sidebar.compact setting

Each sidebar thread takes two lines even when its only metadata is a
timestamp. In compact mode a thread is one row at the tab bar height,
with the metadata on the title line; hover actions replace it.
---
 assets/settings/default.json                |  2 ++
 crates/agent/src/tool_permissions.rs        |  1 +
 crates/agent_settings/src/agent_settings.rs |  2 ++
 crates/agent_ui/src/agent_ui.rs             |  1 +
 crates/settings_content/src/agent.rs        |  4 ++++
 crates/sidebar/src/sidebar.rs               |  2 ++
 crates/ui/src/components/ai/thread_item.rs  | 23 +++++++++++++++++++--
 7 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/assets/settings/default.json b/assets/settings/default.json
index a3b738ed5b..3ba242c467 100644
--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -1180,6 +1180,8 @@
       "default_width": 300,
       // Automatically open the Threads Sidebar when opening a folder in an existing window.
       "auto_open": true,
+      // Show each thread on a single line at the height of the tab bar.
+      "compact": false,
     },
     // Default fixed width when the agent panel is docked to the left or right and
     // `flexible` is false.
diff --git a/crates/agent/src/tool_permissions.rs b/crates/agent/src/tool_permissions.rs
index fa38a0b0bb..750154a1fe 100644
--- a/crates/agent/src/tool_permissions.rs
+++ b/crates/agent/src/tool_permissions.rs
@@ -613,6 +613,7 @@ mod tests {
                 auto_open: true,
                 default_width: px(300.),
                 position: settings::SidebarDockPosition::Left,
+                compact: false,
             },
             thinking_display: Default::default(),
         }
diff --git a/crates/agent_settings/src/agent_settings.rs b/crates/agent_settings/src/agent_settings.rs
index 6372d1abd9..e88b9a9e33 100644
--- a/crates/agent_settings/src/agent_settings.rs
+++ b/crates/agent_settings/src/agent_settings.rs
@@ -257,6 +257,7 @@ pub struct ThreadsSidebarSettings {
     pub auto_open: bool,
     pub position: SidebarDockPosition,
     pub default_width: Pixels,
+    pub compact: bool,
 }
 
 impl AgentSettings {
@@ -785,6 +786,7 @@ impl Settings for AgentSettings {
                     .unwrap()
                     .into_gpui()
                     .clamp(THREADS_LIST_MIN_WIDTH, THREADS_LIST_MAX_WIDTH),
+                compact: threads_sidebar.compact.unwrap(),
             },
             default_width: agent.default_width.unwrap().into_gpui(),
             default_height: agent.default_height.unwrap().into_gpui(),
diff --git a/crates/agent_ui/src/agent_ui.rs b/crates/agent_ui/src/agent_ui.rs
index 7d28603d46..d9bcdf1811 100644
--- a/crates/agent_ui/src/agent_ui.rs
+++ b/crates/agent_ui/src/agent_ui.rs
@@ -1014,6 +1014,7 @@ mod tests {
                 auto_open: true,
                 default_width: px(300.),
                 position: settings::SidebarDockPosition::Left,
+                compact: false,
             },
             thinking_display: Default::default(),
         };
diff --git a/crates/settings_content/src/agent.rs b/crates/settings_content/src/agent.rs
index 6bafc029cb..bf6a194461 100644
--- a/crates/settings_content/src/agent.rs
+++ b/crates/settings_content/src/agent.rs
@@ -57,6 +57,10 @@ pub struct ThreadsSidebarSettingsContent {
     /// Default: 300
     #[schemars(range(min = 200, max = 800))]
     pub default_width: Option<crate::PixelSetting>,
+    /// Whether to show each thread on a single line at the height of the tab bar.
+    ///
+    /// Default: false
+    pub compact: Option<bool>,
 }
 
 #[derive(Copy, Clone, Debug, Default, PartialEq, Eq)]
diff --git a/crates/sidebar/src/sidebar.rs b/crates/sidebar/src/sidebar.rs
index 9fb6380ff3..377b726c7b 100644
