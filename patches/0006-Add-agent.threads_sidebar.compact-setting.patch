+    compact: bool,
 }
 
 impl ThreadItem {
@@ -99,6 +100,7 @@ impl ThreadItem {
             on_hover: Box::new(|_, _, _| {}),
             action_slot: None,
             base_bg: None,
+            compact: false,
         }
     }
 
@@ -246,10 +248,19 @@ impl ThreadItem {
         self.base_bg = Some(color);
         self
     }
+
+    /// Renders the metadata on the title line, at the height of the tab bar.
+    pub fn compact(mut self, compact: bool) -> Self {
+        self.compact = compact;
+        self
+    }
 }
 
 impl RenderOnce for ThreadItem {
     fn render(self, _: &mut Window, cx: &mut App) -> impl IntoElement {
+        let compact = self.compact;
+        // On a single line the hover actions take the metadata's place.
+        let hide_metadata = compact && self.hovered && self.action_slot.is_some();
         let color = cx.theme().colors();
         let raw_bg = self.base_bg.unwrap_or(color.surface_background);
         // The fade gradient paints a solid color over the title to blend it into
@@ -430,6 +441,13 @@ impl RenderOnce for ThreadItem {
             .w_full()
             .py_1()
             .px_1p5()
+            .when(compact, |this| {
+                this.flex_row()
+                    .items_center()
+                    .gap_2()
+                    .py_0()
+                    .h(crate::Tab::container_height(cx))
+            })
             .when(self.selected, |s| s.bg(color.ghost_element_selected))
             .border_1()
             .border_r_2()
@@ -484,11 +502,12 @@ impl RenderOnce for ThreadItem {
                         })
                     }),
             )
