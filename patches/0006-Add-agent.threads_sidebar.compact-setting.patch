                 this.child(
                     h_flex()
                         .gap_1p5()
-                        .child(icon_container()) // Icon Spacing
+                        .when(compact, |this| this.flex_none())
+                        .when(!compact, |this| this.child(icon_container())) // Icon Spacing
                         .when(self.archived, |this| {
                             this.child(
                                 Icon::new(IconName::Archive).size(IconSize::XSmall).color(
