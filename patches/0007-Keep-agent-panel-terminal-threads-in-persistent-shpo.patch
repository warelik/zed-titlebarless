+pub struct ItemCloseGuard {
+    items: Vec<(Box<dyn ItemHandle>, bool)>,
+    changed: Rc<Cell<bool>>,
+    edits: Vec<Rc<Cell<bool>>>,
+    _subscriptions: Vec<Subscription>,
