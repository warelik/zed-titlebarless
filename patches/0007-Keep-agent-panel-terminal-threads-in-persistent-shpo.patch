+fn is_remote_connection_disconnected(project: &Project, cx: &App) -> bool {
+    project
+        .remote_client()
+        .is_some_and(|remote_client| remote_client.read(cx).is_disconnected())
+}
+
+fn reconnect_if_remote_disconnected(project: Entity<Project>, cx: &mut App) {
+    if is_remote_connection_disconnected(project.read(cx), cx) {
+        project.update(cx, |project, cx| {
+            project.disconnected_from_remote(false, cx);
+        });
+    }
+}
+
+struct CloseTerminalErrorToast;
+
+fn kill_persistent_terminal_session_and_delete_metadata(
+    project: Entity<Project>,
+    workspace: WeakEntity<Workspace>,
+    terminal_id: TerminalId,
+    pending_close_completed: bool,
+    cx: &mut App,
+) {
+    let store = TerminalThreadMetadataStore::try_global(cx);
+    if store.as_ref().is_some_and(|store| {
+        !store.update(cx, |store, _| {
+            (pending_close_completed && store.is_intentionally_closing(terminal_id))
+                || store.begin_intentional_close(terminal_id)
+        })
+    }) {
+        return;
+    }
+    let kill = AgentPanel::kill_terminal_session(project, terminal_id, cx);
+    cx.spawn(async move |cx| {
+        let result = kill.await;
+        cx.update(|cx| {
+            if let Some(store) = &store {
+                store.update(cx, |store, cx| {
+                    store.complete_intentional_close(terminal_id, result.is_ok(), cx)
+                });
+            }
+            if let Err(error) = &result {
+                log::error!(
+                    "failed to kill persistent terminal session for terminal {terminal_id}: {error:#}"
+                );
+                workspace
+                    .update(cx, |workspace, cx| {
+                        workspace.show_toast(
+                            workspace::Toast::new(
+                                workspace::notifications::NotificationId::unique::<CloseTerminalErrorToast>(),
+                                format!(
+                                    "Failed to stop terminal session {terminal_id}; close it again to retry"
+                                ),
+                            )
+                            .autohide(),
+                            cx,
+                        );
+                    })
+                    .ok();
+            }
+        });
+        anyhow::Ok(())
+    })
+    .detach_and_log_err(cx);
+}
