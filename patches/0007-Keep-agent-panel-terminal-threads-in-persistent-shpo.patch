+        // 2e. Production kill on non-existent session must succeed idempotently
+        let kill_nonexistent = project
+            .update(cx, |p, cx| {
+                p.kill_persistent_terminal_session("zed-test-isolated".to_string(), cx)
+            })
+            .await;
