+pub fn parse_shpool_probe(stdout: &str) -> Result<Option<ShpoolProbe>> {
+    #[derive(serde::Deserialize)]
+    struct SessionList {
+        sessions: Vec<Session>,
+    }
+    #[derive(serde::Deserialize)]
+    struct Session {
+        name: String,
+    }
