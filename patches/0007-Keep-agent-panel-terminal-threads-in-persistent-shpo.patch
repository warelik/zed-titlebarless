+            "export HOME={home_str:?} XDG_RUNTIME_DIR={runtime_str:?}\n{SHPOOL_SCRIPT_PRELUDE}\n\"$SHPOOL_BIN\" -s \"$SHPOOL_SOCK\" list --json\n"
+        );
