+        // 2. max_tab_rows = Some(0) (treated as 1): all 6 tabs stay on 1 row.
+        set_tab_bar_wrapping_settings(cx, Some(0), Some(100.), Some(200.));
+        let bounds = tab_bounds_all(cx);
+        for ix in 1..6 {
+            assert_eq!(
+                bounds[ix].origin.y, bounds[0].origin.y,
+                "max_tab_rows = 0 must behave as 1 (single row)"
+            );
+        }
+
+        // 3. max_tab_rows = Some(3) without both min_width and max_width: stays on 1 row.
+        for (min_w, max_w) in [(None, Some(200.)), (Some(100.), None), (None, None)] {
+            set_tab_bar_wrapping_settings(cx, Some(3), min_w, max_w);
+            let bounds = tab_bounds_all(cx);
+            for ix in 1..6 {
+                assert_eq!(
+                    bounds[ix].origin.y, bounds[0].origin.y,
+                    "max_tab_rows = 3 with min_width={min_w:?}, max_width={max_w:?} must stay single row"
+                );
+            }
+        }
+
+        // 4. max_tab_rows = Some(3) with both min_width = 100 and max_width = 200:
+        //    In a 300px window, row 1 has navigation and action buttons (W1 < 224px -> cap1 = 1),
+        //    row 2 spans the full 300px width (cap2 = floor((300 - 24) / 100) = 2),
+        //    and row 3 takes the remaining 3 tabs ([0..1, 1..3, 3..6]).
+        set_tab_bar_wrapping_settings(cx, Some(3), Some(100.), Some(200.));
+        let bounds = tab_bounds_all(cx);
+        let row_height = cx.update(|_window, cx| Tab::container_height(cx));
+        let (first_w, full_w) = pane.read_with(cx, |pane, _cx| {
