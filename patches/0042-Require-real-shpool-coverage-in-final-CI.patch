Subject: [PATCH] Require real shpool coverage in the final CI regression

The preserved real-daemon case is mandatory in the source manifest. Fail in CI if its explicit activation or shpool fixture is absent rather than reporting a green early return; retain the opt-in behavior outside CI and every existing isolated probe/kill assertion.
---
 crates/project/src/terminals.rs | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/crates/project/src/terminals.rs b/crates/project/src/terminals.rs
index c48fc1a..19dbd4f 100644
--- a/crates/project/src/terminals.rs
+++ b/crates/project/src/terminals.rs
@@ -1884,6 +1884,10 @@ Last login: Wed Oct 14 20:00:00 2026 from 10.0.0.1
     async fn test_isolated_shpool_daemon_probe_and_kill(cx: &mut gpui::TestAppContext) {
         cx.executor().allow_parking();
         if std::env::var("ZED_TEST_REAL_SHPOOL").is_err() {
+            assert!(
+                std::env::var_os("CI").is_none(),
+                "CI must enable the preserved real-shpool regression"
+            );
             return;
         }
         let has_shpool = smol::process::Command::new("/bin/sh")
@@ -1892,9 +1896,10 @@ Last login: Wed Oct 14 20:00:00 2026 from 10.0.0.1
             .await
             .map(|o| o.status.success())
             .unwrap_or(false);
-        if !has_shpool {
-            return;
-        }
+        assert!(
+            has_shpool,
+            "the enabled real-shpool regression requires shpool on PATH"
+        );
 
         let temp_dir = tempfile::tempdir().expect("tempdir creation");
         let isolated_runtime = temp_dir.path().join("runtime");
