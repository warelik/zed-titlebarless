-            || self.closed_terminal_spawns.contains(&terminal_id);
+        let spawn_is_pending = self.is_terminal_spawn_pending(terminal_id);
         if spawn_is_pending {
+            if !self.closed_terminal_spawns.contains(&terminal_id) {
