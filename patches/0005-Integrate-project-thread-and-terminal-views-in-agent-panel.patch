+        shpool_context: Some(project::terminals::ShpoolSessionContext::for_test()),
+        terminal_id,
+        title: "Feature Terminal".into(),
+        custom_title: None,
+        created_at: Utc::now(),
+        worktree_paths: WorktreePaths::from_path_lists(
+            PathList::new(&[PathBuf::from("/main-repo")]),
+            PathList::new(&[linked_path]),
