+        }
+
+        assert_eq!(
+            fake.attach_history(),
+            vec![expected_session.clone(), expected_session.clone()],
+            "reload must reattach to the exact same shpool session name"
+        );
+        loaded.read_with(cx, |panel, _cx| {
+            assert_eq!(panel.active_terminal_id(), Some(terminal_id));
+        });
