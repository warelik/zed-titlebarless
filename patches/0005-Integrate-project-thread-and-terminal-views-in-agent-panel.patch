+            .collect::<Vec<_>>();
+        let find = |path: &Path| {
+            worktrees
+                .iter()
+                .find(|(_, candidate)| candidate.as_ref() == path)
+                .unwrap()
+                .0
+        };
+        (find(Path::new("/main-repo")), find(linked_path))
+    });
+    let unrelated_item =
+        cx.new(|cx| {
+            TestItem::new(cx).with_dirty(true).with_project_items(&[
+                TestProjectItem::new_in_worktree(1, "src/lib.rs", main_worktree_id, cx),
+            ])
