+#[gpui::test]
+async fn test_item_close_guard_rejects_item_dirtied_after_consent(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    let project = Project::test(fs, [], cx).await;
+    let (multi_workspace, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    let item = cx.new(|cx| TestItem::new(cx));
+
+    // Consent was obtained while the item was clean, but another update dirtied
+    // it before the post-consent guard could be installed.
+    item.update(cx, |item, _| item.is_dirty = true);
+    multi_workspace.update_in(cx, |_multi_workspace, window, cx| {
+        let guard = ItemCloseGuard::new_after_consent(
+            vec![Box::new(item.clone())],
+            &HashSet::default(),
+            window,
+            cx,
+        );
+        assert!(
+            guard.changed(cx),
+            "an item already dirty at post-consent guard construction is unsafe to close"
+        );
+    });
+    assert!(item.read_with(cx, |item, _| item.is_dirty));
+}
