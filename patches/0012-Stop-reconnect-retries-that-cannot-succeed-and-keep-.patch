+        }
+        askpass::AskPassResult::CancelledByUser => {
+            anyhow::Error::new(crate::NonRetryableReconnectError::CanceledByUser)
+        }
+        askpass::AskPassResult::Timedout => anyhow!("connecting to host timed out"),
+    }
