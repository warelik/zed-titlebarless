From 9cecf03eafdca6d7020672610d252f4246d3cdb3 Mon Sep 17 00:00:00 2001
From: warelik <warelik@users.noreply.github.com>
Date: Sun, 11 Oct 2026 16:05:02 +0300
Subject: [PATCH 4/7] Add tabs.min_width and tabs.max_width settings

Tabs size to their title by default, which makes the tab bar uneven.
These optional bounds clamp the tab width; editor titles truncate in
the middle when a maximum is set.
---
 assets/settings/default.json             |  4 +++
 crates/settings/src/vscode_import.rs     |  2 ++
 crates/settings_content/src/workspace.rs |  9 ++++++
 crates/ui/src/components/tab.rs          | 16 ++++++++++
 crates/workspace/src/item.rs             |  4 +++
 crates/workspace/src/pane.rs             |  8 ++++-
 crates/workspace/src/workspace.rs        | 38 ++++++++++++++++++++++++
 7 files changed, 80 insertions(+), 1 deletion(-)

diff --git a/assets/settings/default.json b/assets/settings/default.json
index e981fe7d91..3fd3db5446 100644
--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -1505,6 +1505,10 @@
     // 3. Mark files with errors and warnings:
     //    "all"
     "show_diagnostics": "off",
+    // Minimum width of a tab in pixels; null keeps tabs as wide as their title.
+    "min_width": null,
+    // Maximum width of a tab in pixels; longer titles are truncated in the middle.
+    "max_width": null,
   },
   // Settings related to preview tabs.
   "preview_tabs": {
diff --git a/crates/settings/src/vscode_import.rs b/crates/settings/src/vscode_import.rs
index f4d59b06b2..a82a8c3ffe 100644
--- a/crates/settings/src/vscode_import.rs
+++ b/crates/settings/src/vscode_import.rs
@@ -801,6 +801,8 @@ impl VsCodeSettings {
                         ShowCloseButton::Hidden
                     }
                 }),
+            min_width: None,
+            max_width: None,
         })
     }
 
diff --git a/crates/settings_content/src/workspace.rs b/crates/settings_content/src/workspace.rs
index fd227a3b2e..7fb23a1048 100644
--- a/crates/settings_content/src/workspace.rs
+++ b/crates/settings_content/src/workspace.rs
@@ -206,6 +206,15 @@ pub struct ItemSettingsContent {
     ///
     /// Default: false
     pub show_close_button: Option<ShowCloseButton>,
+    /// Minimum width of a tab in pixels. `null` keeps tabs as wide as their title.
+    ///
+    /// Default: null
+    pub min_width: Option<crate::PixelSetting>,
+    /// Maximum width of a tab in pixels. Longer titles are truncated in the middle.
+    /// `null` keeps tabs as wide as their title.
+    ///
+    /// Default: null
+    pub max_width: Option<crate::PixelSetting>,
 }
 
 #[with_fallible_options]
diff --git a/crates/ui/src/components/tab.rs b/crates/ui/src/components/tab.rs
index 6a25ad4345..37af7a53e0 100644
--- a/crates/ui/src/components/tab.rs
+++ b/crates/ui/src/components/tab.rs
@@ -83,6 +83,22 @@ impl Tab {
     pub fn container_height(cx: &App) -> Pixels {
         DynamicSpacing::Base32.px(cx)
     }
+
+    pub fn min_width(mut self, width: Option<Pixels>) -> Self {
+        if let Some(width) = width {
+            self.div = self.div.min_w(width);
+        }
+        self
+    }
+
+    pub fn max_width(mut self, width: Option<Pixels>) -> Self {
+        if let Some(width) = width {
+            // Clipping drops the automatic minimum width, so without this a crowded tab bar
+            // would squeeze tabs below their title width instead of scrolling.
+            self.div = self.div.max_w(width).overflow_hidden().flex_shrink_0();
+        }
+        self
+    }
 }
 
 impl InteractiveElement for Tab {
diff --git a/crates/workspace/src/item.rs b/crates/workspace/src/item.rs
index ab4195f6a4..15cd5e1723 100644
--- a/crates/workspace/src/item.rs
+++ b/crates/workspace/src/item.rs
@@ -61,6 +61,8 @@ pub struct ItemSettings {
     pub file_icons: bool,
     pub show_diagnostics: ShowDiagnostics,
     pub show_close_button: ShowCloseButton,
+    pub min_width: Option<Pixels>,
+    pub max_width: Option<Pixels>,
 }
 
 #[derive(RegisterSetting)]
@@ -91,6 +93,8 @@ impl Settings for ItemSettings {
             file_icons: tabs.file_icons.unwrap(),
             show_diagnostics: tabs.show_diagnostics.unwrap(),
             show_close_button: tabs.show_close_button.unwrap(),
+            min_width: tabs.min_width.map(|width| gpui::px(width.0)),
+            max_width: tabs.max_width.map(|width| gpui::px(width.0)),
         }
     }
 }
diff --git a/crates/workspace/src/pane.rs b/crates/workspace/src/pane.rs
index 4f16ab577f..7ebc27a223 100644
--- a/crates/workspace/src/pane.rs
+++ b/crates/workspace/src/pane.rs
@@ -2858,7 +2858,7 @@ impl Pane {
                 preview: is_preview,
                 deemphasized: !self.has_focus(window, cx),
                 max_title_len: None,
-                truncate_title_middle: false,
+                truncate_title_middle: ItemSettings::get_global(cx).max_width.is_some(),
             },
             window,
             cx,
@@ -2919,6 +2919,8 @@ impl Pane {
                 ClosePosition::Right => ui::TabCloseSide::End,
             })
             .toggle_state(is_active)
+            .min_width(settings.min_width)
+            .max_width(settings.max_width)
             .on_click(cx.listener({
                 let item_handle = item.boxed_clone();
                 move |pane: &mut Self, event: &ClickEvent, window, cx| {
@@ -3055,6 +3057,10 @@ impl Pane {
                 h_flex()
                     .id(("pane-tab-content", ix))
                     .gap_1()
+                    .when(
+                        settings.min_width.is_some() || settings.max_width.is_some(),
+                        |this| this.flex_grow(1.).min_w_0(),
+                    )
                     .children(if let Some(icon) = icon {
                         Some(icon)
                     } else if !capability.editable() {
diff --git a/crates/workspace/src/workspace.rs b/crates/workspace/src/workspace.rs
index 890b17b3f7..7129e31b0e 100644
--- a/crates/workspace/src/workspace.rs
+++ b/crates/workspace/src/workspace.rs
@@ -13118,6 +13118,44 @@ mod tests {
         assert!(first_tab_left(true, cx) >= without_spacer + px(ui::utils::TRAFFIC_LIGHT_PADDING));
     }
 
+    #[gpui::test]
+    async fn test_tab_width_bounds(cx: &mut TestAppContext) {
+        init_test(cx);
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, None, cx).await;
+        let (workspace, cx) =
+            cx.add_window_view(|window, cx| Workspace::test_new(project, window, cx));
+        add_an_item_to_active_pane(cx, &workspace, 1);
+
+        let tab_width =
+            |min_width: Option<f32>, max_width: Option<f32>, cx: &mut VisualTestContext| {
+                cx.update(|_, cx| {
+                    SettingsStore::update_global(cx, |store, cx| {
+                        store.update_user_settings(cx, |settings| {
+                            let tabs = settings.tabs.get_or_insert_default();
+                            tabs.min_width = min_width.map(Into::into);
+                            tabs.max_width = max_width.map(Into::into);
+                        })
+                    });
+                });
+                cx.run_until_parked();
+                cx.debug_bounds("TAB-0")
+                    .expect("the tab should be rendered")
+                    .size
+                    .width
+            };
+        let natural = tab_width(None, None, cx);
+        assert_eq!(
+            tab_width(Some(natural.as_f32() + 100.), None, cx),
+            natural + px(100.)
+        );
+        assert_eq!(
+            tab_width(None, Some(natural.as_f32() - 10.), cx),
+            natural - px(10.)
+        );
+        assert_eq!(tab_width(None, None, cx), natural);
+    }
+
     #[gpui::test]
     async fn test_window_title_format_empty_project(cx: &mut TestAppContext) {
         init_test(cx);
