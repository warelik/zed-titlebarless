+    #[gpui::test]
+    async fn test_tab_bar_max_tab_rows_recomputes_on_close_and_keeps_pinned_unaffected(
+        cx: &mut TestAppContext,
+    ) {
+        init_test(cx);
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, None, cx).await;
+        let (workspace, cx) =
+            cx.add_window_view(|window, cx| Workspace::test_new(project, window, cx));
+        let pane = workspace.read_with(cx, |workspace, _| workspace.active_pane().clone());
+
+        cx.simulate_resize(size(px(300.), px(300.)));
+        set_tab_bar_wrapping_settings(cx, Some(3), Some(80.), Some(160.));
+
+        for label in ["P0", "P1", "U0", "U1", "U2", "U3", "U4", "U5", "U6"] {
+            add_labeled_item(&pane, label, false, cx);
+        }
+        pane.update_in(cx, |pane, window, cx| {
+            pane.pin_tab_at(0, window, cx);
+            pane.pin_tab_at(1, window, cx);
+        });
+        settle_tab_bar_layout(cx);
+
+        // 1. With show_pinned_tabs_in_separate_row = false:
+        //    Pinned tabs P0, P1 stay in row 1 alongside U0 (cap1 = 1), while U1..U3 wrap to row 2 (cap2 = 3)
+        //    and U4..U6 wrap to row 3.
+        let p0_y = cx.debug_bounds("TAB-0").unwrap().origin.y;
+        let p1_y = cx.debug_bounds("TAB-1").unwrap().origin.y;
+        let u0_y = cx.debug_bounds("TAB-2").unwrap().origin.y;
+        let u1_y = cx.debug_bounds("TAB-3").unwrap().origin.y;
+        let u4_y = cx.debug_bounds("TAB-6").unwrap().origin.y;
+        assert_eq!(p0_y, p1_y, "pinned tabs must stay on row 1");
+        assert_eq!(u0_y, p0_y, "first unpinned tab shares row 1 with inline pinned tabs");
+        assert!(u1_y > p0_y, "unpinned tabs overflow onto row 2");
+        assert!(u4_y > u1_y, "unpinned tabs overflow onto row 3");
+
+        // 2. Enable show_pinned_tabs_in_separate_row = true:
+        //    Pinned tabs occupy their own top row (pinned_y), which does NOT count toward max_tab_rows = 3,
+        //    allowing 3 full-width unpinned rows below pinned_y (3 + 3 + 1 = 7 unpinned tabs).
+        set_pinned_tabs_separate_row(cx, true);
+        settle_tab_bar_layout(cx);
+
+        let pinned_y = cx.debug_bounds("TAB-0").unwrap().origin.y;
+        assert_eq!(cx.debug_bounds("TAB-1").unwrap().origin.y, pinned_y);
+        let row1_y = cx.debug_bounds("TAB-2").unwrap().origin.y;
+        let row2_y = cx.debug_bounds("TAB-5").unwrap().origin.y;
+        let row3_y = cx.debug_bounds("TAB-8").unwrap().origin.y;
+        assert!(
+            pinned_y < row1_y && row1_y < row2_y && row2_y < row3_y,
+            "separate pinned row ({pinned_y:?}) must not count toward max_tab_rows = 3 ({row1_y:?}, {row2_y:?}, {row3_y:?})"
+        );
+        for ix in 2..=4 {
+            assert_eq!(tab_debug_bounds(cx, ix).unwrap().origin.y, row1_y);
+        }
+        for ix in 5..=7 {
+            assert_eq!(tab_debug_bounds(cx, ix).unwrap().origin.y, row2_y);
+        }
+        assert_eq!(cx.debug_bounds("TAB-8").unwrap().origin.y, row3_y);
+
+        // 3. Close 1 unpinned tab (U0 at index 2):
+        //    The 6 remaining unpinned tabs fit into 2 rows (3 + 3), so U6 moves up from row 3 to row 2
+        //    and surplus row 3 disappears immediately.
+        pane.update_in(cx, |pane, window, cx| {
+            let item_id = pane.items[2].item_id();
+            pane.close_item_by_id(item_id, SaveIntent::Close, window, cx)
+        })
+        .await
+        .unwrap();
+        settle_tab_bar_layout(cx);
+
+        assert!(cx.debug_bounds("TAB-8").is_none());
+        assert_eq!(
+            cx.debug_bounds("TAB-7").unwrap().origin.y,
+            row2_y,
+            "last unpinned tab must move up from row 3 to row 2 after closing a tab"
+        );
+
+        // 4. Close 3 more unpinned tabs so only 3 unpinned tabs remain:
+        //    All 3 remaining unpinned tabs move into row 1 and surplus row 2 disappears.
+        for _ in 0..3 {
+            pane.update_in(cx, |pane, window, cx| {
+                let item_id = pane.items[2].item_id();
+                pane.close_item_by_id(item_id, SaveIntent::Close, window, cx)
+            })
+            .await
+            .unwrap();
+        }
+        settle_tab_bar_layout(cx);
+
+        assert!(cx.debug_bounds("TAB-5").is_none());
+        for ix in 2..=4 {
+            assert_eq!(
+                tab_debug_bounds(cx, ix).unwrap().origin.y,
+                row1_y,
+                "remaining 3 unpinned tabs must all sit on unpinned row 1"
+            );
+        }
+    }
