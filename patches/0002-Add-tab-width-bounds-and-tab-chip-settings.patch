+    #[gpui::test]
+    async fn test_tab_bar_max_tab_rows_proportional_shrink_and_last_row_scroll(
+        cx: &mut TestAppContext,
+    ) {
+        init_test(cx);
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, None, cx).await;
+        let (workspace, cx) =
+            cx.add_window_view(|window, cx| Workspace::test_new(project, window, cx));
+        let pane = workspace.read_with(cx, |workspace, _| workspace.active_pane().clone());
+
+        cx.simulate_resize(size(px(220.), px(300.)));
+        set_tab_bar_wrapping_settings(cx, Some(3), Some(30.), Some(120.));
+
+        add_labeled_item(&pane, "0", false, cx);
+        settle_tab_bar_layout(cx);
+
+        let natural_width = cx
+            .debug_bounds("TAB-0")
+            .expect("TAB-0 should be rendered")
+            .size
+            .width;
+        assert!(
+            natural_width > px(30.) && natural_width <= px(120.),
+            "TestItem natural width ({natural_width:?}) should lie strictly between min_width (30px) and max_width (120px)"
+        );
+
+        let (first_w, full_w) = pane.read_with(cx, |pane, _cx| {
+            (
+                pane.tab_rows
+                    .first_row_width
+                    .expect("first_row_width should be measured"),
+                pane.tab_rows
+                    .full_row_width
+                    .expect("full_row_width should be measured"),
+            )
+        });
+        let cap1 = ui::tab_row_capacity(first_w, px(30.), ui::TAB_BAR_FILLER_MIN_WIDTH);
+        let cap2 = ui::tab_row_capacity(full_w, px(30.), ui::TAB_BAR_FILLER_MIN_WIDTH);
+        assert_eq!(cap2, 6);
+
+        // Add tabs so Row 1 has `cap1` tabs and Row 2 has 2 tabs (which fit at natural width ~44px in 220px).
+        for ix in 1..(cap1 + 2) {
+            add_labeled_item(&pane, &ix.to_string(), false, cx);
+        }
+        settle_tab_bar_layout(cx);
+
+        let row1_y = cx.debug_bounds("TAB-0").unwrap().origin.y;
+        let row2_first_bounds = tab_debug_bounds(cx, cap1)
+            .expect("first tab in row 2 should be rendered");
+        let row2_y = row2_first_bounds.origin.y;
+        assert!(row2_y > row1_y, "tabs should wrap onto row 2");
+        assert!(
+            (row2_first_bounds.size.width - natural_width).abs() < px(1.),
+            "tabs in non-full row 2 ({:?}) should keep their natural width ({natural_width:?})",
+            row2_first_bounds.size.width
+        );
+
+        // Fill Row 2 to its capacity `cap2 = 6` (6 * 44 + 24 = 288 > 220 >= 6 * 30 + 24 = 204),
+        // so tabs in Row 2 shrink below natural_width but never below min_width (30px).
+        for ix in (cap1 + 2)..(cap1 + cap2) {
+            add_labeled_item(&pane, &ix.to_string(), false, cx);
+        }
+        settle_tab_bar_layout(cx);
+
+        for ix in cap1..(cap1 + cap2) {
+            let bounds = tab_debug_bounds(cx, ix)
+                .unwrap_or_else(|| panic!("TAB-{ix} should be rendered in row 2"));
+            assert_eq!(bounds.origin.y, row2_y, "TAB-{ix} should remain in row 2");
+            assert!(
+                bounds.size.width < natural_width - px(1.)
+                    && bounds.size.width >= px(30.) - px(0.5),
+                "TAB-{ix} in full row 2 should shrink below natural width ({natural_width:?}) and >= min_width (30px), got {:?}",
+                bounds.size.width
+            );
+        }
+
+        // Add more tabs so Row 3 overflows (cap1 + cap2 + cap2 + 5 tabs).
+        let row3_start = cap1 + cap2;
+        let total_tabs = row3_start + cap2 + 5;
+        for ix in row3_start..total_tabs {
+            add_labeled_item(&pane, &ix.to_string(), false, cx);
+        }
+        settle_tab_bar_layout(cx);
+
+        let row3_y = tab_debug_bounds(cx, row3_start)
+            .expect("first tab of row 3 should be rendered")
+            .origin
+            .y;
+        assert!(row3_y > row2_y, "row 3 must be positioned below row 2");
+
+        for ix in row3_start..total_tabs {
+            let bounds = tab_debug_bounds(cx, ix)
+                .unwrap_or_else(|| panic!("TAB-{ix} should be rendered in row 3"));
+            assert_eq!(
+                bounds.origin.y, row3_y,
+                "TAB-{ix} must stay in row 3 (no 4th row allowed when max_tab_rows = 3)"
+            );
+            assert!(
+                (bounds.size.width - px(30.)).abs() < px(1.),
+                "overflowing row 3 tab TAB-{ix} must compress to min_width (30px), got {:?}",
+                bounds.size.width
+            );
+        }
+
+        // Activate tab 0, then activate the last tab in Row 3 and verify Row 3 scrolls it completely into view.
+        pane.update_in(cx, |pane, window, cx| {
+            pane.activate_item(0, true, true, window, cx);
+        });
+        settle_tab_bar_layout(cx);
+
+        let last_ix = total_tabs - 1;
+        pane.update_in(cx, |pane, window, cx| {
+            pane.activate_item(last_ix, true, true, window, cx);
+        });
+        settle_tab_bar_layout(cx);
+
+        let scroll_handle = pane.read_with(cx, |pane, _| pane.tab_bar_scroll_handle.clone());
+        assert!(
+            scroll_handle.max_offset().x > px(0.),
+            "row 3 must overflow horizontally"
+        );
+        assert!(
+            scroll_handle.offset().x < px(0.),
+            "row 3 must scroll horizontally to reveal the active tab"
+        );
+        let scroll_bounds = scroll_handle.bounds();
+        let last_tab_bounds = tab_debug_bounds(cx, last_ix)
+            .expect("active last tab in row 3 should be rendered");
+        assert!(
+            last_tab_bounds.left() >= scroll_bounds.left() - px(1.)
+                && last_tab_bounds.right() <= scroll_bounds.right() + px(1.),
+            "active tab in row 3 ({last_tab_bounds:?}) must be scrolled completely into view ({scroll_bounds:?})"
+        );
+    }
