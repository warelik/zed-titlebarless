+    #[gpui::test]
+    async fn test_tab_bar_max_tab_rows_drop_in_row_empty_space(cx: &mut TestAppContext) {
+        init_test(cx);
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, None, cx).await;
+        let (workspace, cx) =
+            cx.add_window_view(|window, cx| Workspace::test_new(project, window, cx));
+        let pane = workspace.read_with(cx, |workspace, _| workspace.active_pane().clone());
+
+        // With window width 330px and min_width = max_width = 80px:
+        // Row 1 available width W1 is ~220px -> cap1 = floor((220 - 24) / 80) = 2 tabs ([0, 1]),
+        // leaving ~60px of empty filler space at the right end of Row 1.
+        // Row 2 has tabs [2, 3].
+        cx.simulate_resize(size(px(330.), px(300.)));
+        set_tab_bar_wrapping_settings(cx, Some(3), Some(80.), Some(80.));
+
+        for label in ["A", "B", "C", "D"] {
+            add_labeled_item(&pane, label, false, cx);
+        }
+        assert_item_labels(&pane, ["A", "B", "C", "D*"], cx);
+        settle_tab_bar_layout(cx);
+
+        let tab0 = cx.debug_bounds("TAB-0").unwrap();
+        let tab1 = cx.debug_bounds("TAB-1").unwrap();
+        let tab2 = cx.debug_bounds("TAB-2").unwrap();
+        let tab3 = cx.debug_bounds("TAB-3").unwrap();
+        assert_eq!(tab0.origin.y, tab1.origin.y, "A and B should be on row 1");
+        assert_eq!(tab2.origin.y, tab3.origin.y, "C and D should be on row 2");
+        assert!(
+            tab0.origin.y < tab2.origin.y,
+            "row 1 must be above row 2 when max_tab_rows = 3"
+        );
+
+        // 1. Drag tab D (index 3, in row 2) onto row 1's empty space filler (immediately right of TAB-1):
+        //    It must be placed right after row 1's last tab B (at index 2, before C).
+        let row1_empty_pos = gpui::point(tab1.right() + px(12.), tab1.center().y);
+        cx.simulate_event(MouseDownEvent {
+            position: tab3.center(),
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 1,
+            first_mouse: false,
+        });
+        cx.run_until_parked();
+        cx.simulate_event(MouseMoveEvent {
+            position: row1_empty_pos,
+            pressed_button: Some(MouseButton::Left),
+            modifiers: Modifiers::default(),
+        });
+        cx.run_until_parked();
+        cx.simulate_event(MouseUpEvent {
+            position: row1_empty_pos,
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 1,
+        });
+        settle_tab_bar_layout(cx);
+
+        assert_item_labels(&pane, ["A", "B", "D*", "C"], cx);
+
+        // 2. Drag tab A (index 0, first tab in row 1) onto row 1's empty space filler:
+        //    It must land immediately after row 1's last tab B (at index 1, before D).
+        let tab0 = cx.debug_bounds("TAB-0").unwrap();
+        let tab1 = cx.debug_bounds("TAB-1").unwrap();
+        let row1_empty_pos = gpui::point(tab1.right() + px(12.), tab1.center().y);
+        cx.simulate_event(MouseDownEvent {
+            position: tab0.center(),
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 1,
+            first_mouse: false,
+        });
+        cx.run_until_parked();
+        cx.simulate_event(MouseMoveEvent {
+            position: row1_empty_pos,
+            pressed_button: Some(MouseButton::Left),
+            modifiers: Modifiers::default(),
+        });
+        cx.run_until_parked();
+        cx.simulate_event(MouseUpEvent {
+            position: row1_empty_pos,
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 1,
+        });
+        settle_tab_bar_layout(cx);
+
+        assert_item_labels(&pane, ["B", "A*", "D", "C"], cx);
+
+        // 3. Double-clicking the empty space at the end of row 2 dispatches the double-click action (NewFile).
+        let new_file_dispatched = Rc::new(Cell::new(false));
+        cx.update(|_window, cx| {
+            let new_file_dispatched = new_file_dispatched.clone();
+            cx.on_action(move |_: &NewFile, _cx| {
+                new_file_dispatched.set(true);
+            });
+        });
+        let tab3 = cx.debug_bounds("TAB-3").unwrap();
+        let row2_empty_pos = gpui::point(tab3.right() + px(12.), tab3.center().y);
+        cx.simulate_event(MouseDownEvent {
+            position: row2_empty_pos,
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 2,
+            first_mouse: false,
+        });
+        cx.run_until_parked();
+        cx.simulate_event(MouseUpEvent {
+            position: row2_empty_pos,
+            button: MouseButton::Left,
+            modifiers: Modifiers::default(),
+            click_count: 2,
+        });
+        cx.run_until_parked();
+        assert!(
+            new_file_dispatched.get(),
+            "double-clicking row 2 empty space filler must dispatch the new file action"
+        );
+    }
