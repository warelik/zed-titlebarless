+        );
+        let cap1 = ui::tab_row_capacity(first_w, px(100.), ui::TAB_BAR_FILLER_MIN_WIDTH);
+        let cap2 = ui::tab_row_capacity(full_w, px(100.), ui::TAB_BAR_FILLER_MIN_WIDTH);
+        assert_eq!(cap1, 1);
+        assert_eq!(cap2, 2);
+        assert_eq!(
+            ui::tab_row_ranges(6, cap1, cap2, 3),
+            vec![0..1, 1..3, 3..6]
+        );
+
+        let row1_y = bounds[0].origin.y;
+        let row2_y = bounds[1].origin.y;
+        let row3_y = bounds[3].origin.y;
+        assert_eq!(row2_y - row1_y, row_height);
+        assert_eq!(row3_y - row2_y, row_height);
+        assert_eq!(bounds[2].origin.y, row2_y);
+        assert_eq!(bounds[4].origin.y, row3_y);
+        assert_eq!(bounds[5].origin.y, row3_y);
+        assert!(bounds[1].origin.x < bounds[2].origin.x);
+        assert!(bounds[3].origin.x < bounds[4].origin.x);
+        assert!(bounds[4].origin.x < bounds[5].origin.x);
+
+        // Row 1 is inset by navigation buttons, while Rows 2 and 3 start at the pane's left edge.
+        assert!(
+            bounds[0].origin.x > bounds[1].origin.x,
+            "row 1 first tab ({:?}) must start to the right of row 2 first tab ({:?})",
+            bounds[0].origin.x,
+            bounds[1].origin.x
+        );
+        assert_eq!(bounds[1].origin.x, bounds[3].origin.x);
+
+        let plus_button_bounds = cx
+            .debug_bounds("ICON-Plus")
+            .expect("new tab button should be rendered");
+        assert!(
+            plus_button_bounds.center().y >= bounds[0].top()
+                && plus_button_bounds.center().y <= bounds[0].bottom(),
+            "tab bar action buttons must stay in row 1"
+        );
+
+        #[cfg(target_os = "macos")]
+        {
+            let without_traffic_lights_x = bounds[0].origin.x;
+            cx.update_global(|store: &mut SettingsStore, cx| {
+                store.update_user_settings(cx, |settings| {
+                    settings.workspace.title_bar_to_status_bar = Some(true);
+                });
+            });
+            settle_tab_bar_layout(cx);
+            let bounds_tl = tab_bounds_all(cx);
+            assert!(
+                bounds_tl[0].origin.x
+                    >= without_traffic_lights_x + px(ui::utils::TRAFFIC_LIGHT_PADDING),
+                "row 1 must reserve traffic-light space when title_bar_to_status_bar is enabled"
+            );
+            assert_eq!(
+                bounds_tl[1].origin.x, bounds[1].origin.x,
+                "row 2 must start at full pane left edge without traffic-light spacer"
+            );
+        }
+    }
