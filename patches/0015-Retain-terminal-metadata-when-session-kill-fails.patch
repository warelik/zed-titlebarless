From b0be8844db1533fd725dc53f64a3d015578e4dae Mon Sep 17 00:00:00 2001
From: Codex Repair <codex-repair@localhost>
Date: Sun, 18 Oct 2026 01:50:57 +0000
Subject: [PATCH] Retain terminal metadata when session kill fails

Delete persistent terminal metadata only after the shpool kill succeeds, so a disconnected remote leaves enough information to retry the close after reconnecting. Add coverage for the failure path.
---
 crates/agent_ui/src/agent_panel.rs | 86 +++++++++++++++++++++++++++---
 crates/project/src/terminals.rs    |  4 ++
 2 files changed, 82 insertions(+), 8 deletions(-)

diff --git a/crates/agent_ui/src/agent_panel.rs b/crates/agent_ui/src/agent_panel.rs
index c868051..888314a 100644
--- a/crates/agent_ui/src/agent_panel.rs
+++ b/crates/agent_ui/src/agent_panel.rs
@@ -2621,18 +2621,27 @@ impl AgentPanel {
         // Closing is the only way a terminal thread goes away, so its session
         // goes with it, also when the thread was not spawned in this run.
         if should_kill_persistent_session {
-            self.project
-                .update(cx, |project, cx| {
-                    project.kill_persistent_terminal_session(terminal_id.session_name(), cx)
-                })
-                .detach_and_log_err(cx);
-        }
-        self.terminals.remove(&terminal_id);
-        if let Some(store) = TerminalThreadMetadataStore::try_global(cx) {
+            let kill_session = self.project.update(cx, |project, cx| {
+                project.kill_persistent_terminal_session(terminal_id.session_name(), cx)
+            });
+            cx.spawn(async move |_this, cx| -> Result<()> {
+                kill_session.await?;
+                cx.update(|cx| {
+                    if let Some(store) = TerminalThreadMetadataStore::try_global(cx) {
+                        store.update(cx, |store, cx| {
+                            store.delete(terminal_id, cx);
+                        });
+                    }
+                });
+                Ok(())
+            })
+            .detach_and_log_err(cx);
+        } else if let Some(store) = TerminalThreadMetadataStore::try_global(cx) {
             store.update(cx, |store, cx| {
                 store.delete(terminal_id, cx);
             });
         }
+        self.terminals.remove(&terminal_id);
         if was_active {
             self.base_view = BaseView::Uninitialized;
             self.refresh_base_view_subscriptions(window, cx);
@@ -16261,6 +16270,67 @@ mod tests {
         });
     }
 
+    #[gpui::test]
+    async fn test_failed_terminal_session_kill_retains_metadata(cx: &mut TestAppContext) {
+        init_test(cx);
+        cx.update(|cx| {
+            agent::ThreadStore::init_global(cx);
+            TerminalThreadMetadataStore::init_global(cx);
+            language_model::LanguageModelRegistry::test(cx);
+        });
+
+        let fs = FakeFs::new(cx.executor());
+        cx.update(|cx| <dyn fs::Fs>::set_global(fs.clone(), cx));
+        let project = Project::test(fs.clone(), [Path::new("/project")], cx).await;
+        let fake = project.update(cx, |p, _| p.enable_fake_shpool(&[]));
+
+        let multi_workspace =
+            cx.add_window(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+        let workspace = multi_workspace
+            .read_with(cx, |multi_workspace, _cx| {
+                multi_workspace.workspace().clone()
+            })
+            .unwrap();
+        let cx = &mut VisualTestContext::from_window(multi_workspace.into(), cx);
+        let panel = workspace.update_in(cx, |workspace, window, cx| {
+            cx.new(|cx| AgentPanel::new(workspace, window, cx))
+        });
+
+        let terminal_id = TerminalId::new();
+        let metadata = TerminalThreadMetadata {
+            terminal_id,
+            title: "Unloaded".into(),
+            custom_title: None,
+            created_at: Utc::now(),
+            worktree_paths: WorktreePaths::from_folder_paths(&PathList::new(&[PathBuf::from(
+                "/project",
+            )])),
+            remote_connection: None,
+            working_directory: None,
+        };
+        cx.update(|_, cx| {
+            TerminalThreadMetadataStore::global(cx).update(cx, |store, cx| {
+                store.save(metadata, cx);
+            });
+        });
+        fake.state.lock().kill_error = Some("no remote connection".into());
+
+        panel.update_in(cx, |panel, window, cx| {
+            panel.close_terminal(terminal_id, window, cx);
+        });
+        cx.run_until_parked();
+
+        cx.update(|_, cx| {
+            assert!(
+                TerminalThreadMetadataStore::global(cx)
+                    .read(cx)
+                    .entry(terminal_id)
+                    .is_some(),
+                "a failed session kill must retain metadata for a later retry"
+            );
+        });
+    }
+
     #[gpui::test]
     async fn test_process_exited_keeps_thread_and_enter_restart(cx: &mut TestAppContext) {
         init_test(cx);
diff --git a/crates/project/src/terminals.rs b/crates/project/src/terminals.rs
index 6ae3786..4e4b80d 100644
--- a/crates/project/src/terminals.rs
+++ b/crates/project/src/terminals.rs
@@ -70,6 +70,7 @@ pub struct FakeShpoolState {
     pub attach_history: Vec<String>,
     pub attach_args_history: Vec<(String, Vec<String>)>,
     pub kill_history: Vec<String>,
+    pub kill_error: Option<String>,
 }
 
 #[cfg(any(test, feature = "test-support"))]
@@ -637,6 +638,9 @@ impl Project {
         if let Some(fake) = &self.fake_shpool {
             let mut state = fake.state.lock();
             state.kill_history.push(session_name.clone());
+            if let Some(error) = &state.kill_error {
+                return Task::ready(Err(anyhow::anyhow!(error.clone())));
+            }
             state.sessions.remove(&session_name);
             return Task::ready(Ok(()));
         }
