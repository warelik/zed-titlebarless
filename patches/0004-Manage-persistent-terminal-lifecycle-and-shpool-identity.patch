+/// Terminal ownership uses persisted routing details in addition to workspace host identity.
+pub fn same_terminal_remote_connection(
+    left: Option<&RemoteConnectionOptions>,
+    right: Option<&RemoteConnectionOptions>,
+) -> bool {
+    if left.map(RemoteConnectionOptions::identity) != right.map(RemoteConnectionOptions::identity) {
+        return false;
+    }
+    match (left, right) {
+        (Some(RemoteConnectionOptions::Ssh(left)), Some(RemoteConnectionOptions::Ssh(right))) => {
+            left.args.as_deref().unwrap_or_default() == right.args.as_deref().unwrap_or_default()
+        }
+        (
+            Some(RemoteConnectionOptions::Docker(left)),
+            Some(RemoteConnectionOptions::Docker(right)),
+        ) => left.name == right.name,
+        _ => true,
+    }
+}
