+            .args(["-c", "command -v shpool || [ -x /opt/homebrew/bin/shpool ] || [ -x $HOME/.local/bin/shpool ] || [ -x $HOME/.cargo/bin/shpool ]"])
+            .output()
+            .await
+            .map(|o| o.status.success())
+            .unwrap_or(false);
