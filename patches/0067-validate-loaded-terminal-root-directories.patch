From d82c97d9345a6d60afeb25476651312db14dce12 Mon Sep 17 00:00:00 2001
From: "github-actions[bot]"
 <41898282+github-actions[bot]@users.noreply.github.com>
Date: Mon, 19 Oct 2026 03:22:12 +0000
Subject: [PATCH] Validate loaded saved terminal roots as directories before
 closing

Reject placeholder and regular-file worktrees using the loaded root metadata, with the native initial snapshot barrier for remote worktrees. Preserve all previously executed test fixtures and add first-root file replacement and recovery to the new multi-root regression.
---
 crates/sidebar/src/sidebar.rs       | 22 ++++++++++++----------
 crates/sidebar/src/sidebar_tests.rs | 15 +++++++++++++++
 2 files changed, 27 insertions(+), 10 deletions(-)

diff --git a/crates/sidebar/src/sidebar.rs b/crates/sidebar/src/sidebar.rs
index dfac458..5b4c6dc 100644
--- a/crates/sidebar/src/sidebar.rs
+++ b/crates/sidebar/src/sidebar.rs
@@ -5320,20 +5320,22 @@ impl Sidebar {
             // Load the saved roots so per-project terminal settings/environment
             // select the same daemon as terminal activation would.
             for path in paths {
-                // Worktree creation accepts nonexistent roots. Resolve the
-                // actual local/remote path before selecting its daemon context.
-                let resolve = project.update(cx, |project, cx| {
-                    project.resolve_abs_path(&path.to_string_lossy(), cx)
+                let load = project.update(cx, |project, cx| {
+                    project.find_or_create_worktree(path.as_path(), true, cx)
                 });
+                let (worktree, _) = load.await?;
+                // Remote AddWorktree returns before its initial snapshot is
+                // delivered. Use the existing scan barrier before inspecting it.
+                if worktree.read_with(cx, |worktree, _| worktree.is_remote()) {
+                    worktree.update(cx, |worktree, _| worktree.wait_for_snapshot(1)).await?;
+                }
+                // The loaded model, rather than a pre-load existence query,
+                // must provide a directory for root-scoped terminal settings.
                 anyhow::ensure!(
-                    resolve.await.is_some(),
-                    "saved terminal root is unavailable: {}",
+                    worktree.read_with(cx, |worktree, _| worktree.root_dir().is_some()),
+                    "saved terminal root is unavailable or not a directory: {}",
                     path.display(),
                 );
-                let load = project.update(cx, |project, cx| {
-                    project.find_or_create_worktree(path.as_path(), true, cx)
-                });
-                load.await?;
             }
             anyhow::Ok(project)
         })
diff --git a/crates/sidebar/src/sidebar_tests.rs b/crates/sidebar/src/sidebar_tests.rs
index bdb324c..506265b 100644
--- a/crates/sidebar/src/sidebar_tests.rs
+++ b/crates/sidebar/src/sidebar_tests.rs
@@ -5270,6 +5270,21 @@ async fn test_saved_terminal_checks_every_root_and_allows_retry(cx: &mut TestApp
         assert!(!store.read(cx).is_intentionally_closing(terminal_id));
     });
     fs.as_fake().insert_tree("/missing-second", serde_json::json!({})).await;
+    fs.remove_dir(Path::new("/available-first"), Default::default()).await.unwrap();
+    fs.as_fake().insert_file("/available-first", b"now a regular file".to_vec()).await;
+    sidebar.update_in(cx, |sidebar, window, cx| {
+        sidebar.close_terminal(&metadata, &entry_workspace, window, cx);
+    });
+    cx.run_until_parked();
+    assert!(fake.kill_history().is_empty(), "a former first directory must not select the global daemon");
+    assert!(fake.has_session(&session_name));
+    cx.update(|_, cx| {
+        let store = TerminalThreadMetadataStore::global(cx);
+        assert!(store.read(cx).entry(terminal_id).is_some());
+        assert!(!store.read(cx).is_intentionally_closing(terminal_id));
+    });
+    fs.remove_file(Path::new("/available-first"), Default::default()).await.unwrap();
+    fs.as_fake().insert_tree("/available-first", serde_json::json!({})).await;
     sidebar.update_in(cx, |sidebar, window, cx| {
         sidebar.close_terminal(&metadata, &entry_workspace, window, cx);
     });
