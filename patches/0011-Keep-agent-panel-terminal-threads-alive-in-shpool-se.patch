+pub struct PersistentTerminal {
+    pub terminal: Entity<Terminal>,
+    pub session: PersistentSession,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PersistentSession {
+    /// The host has no usable shpool, so the terminal runs a plain shell.
+    Unavailable,
+    Created,
+    Reattached,
+}
+
+/// A program that replaces the configured shell of a terminal.
+struct ShellCommand {
+    program: String,
+    args: Vec<String>,
+    title_override: Option<String>,
+}
+
+/// Prints the shpool binary on the first line, then its sessions as JSON.
+const SHPOOL_PROBE_COMMAND: &str = "command -v shpool && shpool list --json";
+
+struct ShpoolProbe {
+    program: String,
+    sessions: Vec<String>,
+}
+
+fn parse_shpool_probe(stdout: &str) -> Option<ShpoolProbe> {
+    #[derive(serde::Deserialize)]
+    struct SessionList {
+        sessions: Vec<Session>,
+    }
+    #[derive(serde::Deserialize)]
+    struct Session {
+        name: String,
+    }
+
+    let (program, sessions) = stdout.split_once('\n')?;
+    let program = program.trim();
+    if program.is_empty() {
+        return None;
+    }
+    let sessions = serde_json::from_str::<SessionList>(sessions)
+        .context("parsing `shpool list --json`")
+        .log_err()?;
+    Some(ShpoolProbe {
+        program: program.to_string(),
+        sessions: sessions
+            .sessions
+            .into_iter()
+            .map(|session| session.name)
+            .collect(),
+    })
+}
