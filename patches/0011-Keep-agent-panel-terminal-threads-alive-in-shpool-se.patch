+        let (release_tx, spawn_gate) = futures::channel::oneshot::channel::<()>();
+        let terminal_id = TerminalId::new();
+        let metadata = TerminalThreadMetadata {
+            terminal_id,
+            title: "Terminal".into(),
+            custom_title: None,
+            created_at: Utc::now(),
