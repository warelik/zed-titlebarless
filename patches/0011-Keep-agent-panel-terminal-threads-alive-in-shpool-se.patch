+        let terminal = cx.new(|_cx| make_display_only_terminal());
+        let initial_bounds = terminal.read_with(cx, |t, _| t.last_content.terminal_bounds);
+
+        terminal.update(cx, |term, cx| {
+            term.pty_resize_hold = PtyResizeHold::HoldingOutput {
