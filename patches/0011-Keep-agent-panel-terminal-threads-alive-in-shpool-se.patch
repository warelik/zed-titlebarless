+                if !check.status.success() {
+                    daemon_dead = true;
+                    break;
+                }
+            }
+            cx.background_executor
+                .timer(std::time::Duration::from_millis(100))
+                .await;
+        }
+        assert!(
+            daemon_dead,
+            "daemon PID {daemon_pid} must exit cleanly after SIGTERM"
+        );
+    }
