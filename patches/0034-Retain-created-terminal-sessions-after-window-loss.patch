+            panel.test_terminal_spawn_gate = Some(gate);
+            panel.new_terminal(None, AgentThreadSource::AgentPanel, window, cx);
+            *panel.pending_terminal_spawns.iter().next().expect("startup must be gated")
+        });
+        cx.run_until_parked();
+        cx.update(|window, _| window.remove_window());
+        drop(panel);
+        drop(project);
+        release.send(()).expect("app-scoped startup must survive its window");
+        cx.cx.run_until_parked();
+        assert!(fake.has_session(&id.session_name()));
+        cx.cx.update(|cx| {
+            let store = TerminalThreadMetadataStore::global(cx);
+            assert!(store.read(cx).entry(id).is_some(), "created session must remain discoverable");
+            assert!(!store.read(cx).is_restore_blocked(id));
+        });
+    }
