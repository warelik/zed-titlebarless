+fn validate_fork_update_config(config: &ForkUpdateConfig) -> Result<()> {
+    anyhow::ensure!(
+        config.release_id > 0,
+        "ZED_DOWNSTREAM_RELEASE_ID must be a positive integer"
+    );
+    github_repository_from_manifest_url(&config.manifest_url)?;
+    Ok(())
+}
+
+fn github_repository_from_manifest_url(manifest_url: &str) -> Result<String> {
+    let path = manifest_url
+        .strip_prefix("https://github.com/")
+        .context("fork manifest URL must use https://github.com")?;
+    let segments: Vec<_> = path.split('/').collect();
+    anyhow::ensure!(
+        segments.len() == 6
+            && segments[2] == "releases"
+            && segments[3] == "latest"
+            && segments[4] == "download"
+            && segments[5] == "latest.json",
+        "fork manifest URL must end with /releases/latest/download/latest.json"
+    );
+    let owner = segments[0];
+    let repository = segments[1];
+    let is_valid_component = |component: &str| {
+        !component.is_empty()
+            && component != "."
+            && component != ".."
+            && component.bytes().all(|byte| {
+                byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.')
+            })
+    };
+    anyhow::ensure!(
+        is_valid_component(owner) && is_valid_component(repository),
+        "fork manifest URL must identify a GitHub owner and repository"
+    );
+    Ok(format!("https://github.com/{owner}/{repository}"))
+}
+
+fn is_lowercase_hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn validate_fork_release(
+    release: &ForkReleaseAsset,
+    config: &ForkUpdateConfig,
+) -> Result<Version> {
+    validate_fork_update_config(config)?;
+    anyhow::ensure!(release.schema == 1, "unsupported fork manifest schema");
+    anyhow::ensure!(release.release_id > 0, "fork release ID must be positive");
+    anyhow::ensure!(
+        release.platform == "macos/aarch64",
+        "unsupported fork release platform: {}",
+        release.platform
+    );
+    let version = Version::parse(&release.release.version)?;
+    anyhow::ensure!(
+        version.pre.is_empty()
+            && version.build.is_empty()
+            && version.to_string() == release.release.version,
+        "fork release version must be a canonical stable version"
+    );
+    anyhow::ensure!(
+        is_lowercase_hex(&release.candidate_sha, 40),
+        "fork candidate SHA must be 40 lowercase hex characters"
+    );
+    anyhow::ensure!(
+        is_lowercase_hex(&release.upstream_sha, 40),
+        "fork upstream SHA must be 40 lowercase hex characters"
+    );
+    anyhow::ensure!(
+        is_lowercase_hex(&release.patchset_sha256, 64),
+        "fork patchset SHA-256 must be 64 lowercase hex characters"
+    );
+    anyhow::ensure!(
+        is_lowercase_hex(&release.sha256, 64),
+        "fork archive SHA-256 must be 64 lowercase hex characters"
+    );
+    anyhow::ensure!(
+        release.size > 0 && release.size < 2_147_483_648,
+        "fork archive size is outside the allowed range"
+    );
+
+    let repository = github_repository_from_manifest_url(&config.manifest_url)?;
+    let expected_url = format!(
+        "{repository}/releases/download/build-{}-{}-{}/Zed.dmg",
+        release.release.version,
+        &release.upstream_sha[..12],
+        &release.patchset_sha256[..12],
+    );
+    anyhow::ensure!(
+        release.release.url == expected_url,
+        "fork release asset URL does not match its repository and provenance"
+    );
+
+    Ok(version)
+}
