+    fn test_fork_manifest_requires_the_exact_release_contract() {
+        let config = test_fork_config(41);
+        let valid_manifest = test_fork_manifest(
+            "1.24.2",
+            42,
+            "macos/aarch64",
+            3,
+            TEST_FORK_CANDIDATE_SHA,
+            TEST_FORK_UPSTREAM_SHA,
+            TEST_FORK_PATCHSET_SHA256,
+            TEST_FORK_ARCHIVE_SHA256,
+            None,
+        );
+        let parsed = parse_test_fork_manifest(valid_manifest.clone());
+        assert_eq!(
+            validate_fork_release(&parsed, &config).expect("valid fork manifest"),
+            Version::new(1, 24, 2)
+        );
+
+        let invalid_manifests = [
+            ("schema", serde_json::json!(2)),
+            ("platform", serde_json::json!("macos/x86_64")),
+            ("release_id", serde_json::json!(0)),
+            ("size", serde_json::json!(0)),
+            ("size", serde_json::json!(2_147_483_648u64)),
+            ("candidate_sha", serde_json::json!("ABCDEF")),
+            ("upstream_sha", serde_json::json!("g".repeat(40))),
+            ("patchset_sha256", serde_json::json!("a".repeat(63))),
+            ("sha256", serde_json::json!("A".repeat(64))),
+            ("version", serde_json::json!("1.24.2-rc.1")),
+            ("version", serde_json::json!("1.24.2+build.1")),
+            ("version", serde_json::json!("01.24.2")),
+            ("url", serde_json::json!("not-a-url")),
+            (
+                "url",
+                serde_json::json!(
+                    "https://example.com/example/zed/releases/download/build-1.24.2-89abcdef0123-0123456789ab/Zed.dmg"
+                ),
+            ),
+            (
+                "url",
+                serde_json::json!(
+                    "https://github.com/example/zed/releases/download/../latest/Zed.dmg"
+                ),
+            ),
+        ];
+        for (field, invalid_value) in invalid_manifests {
+            let mut manifest = valid_manifest.clone();
+            manifest[field] = invalid_value;
+            assert!(
+                validate_test_fork_manifest(manifest, &config).is_err(),
+                "invalid {field} must be rejected"
+            );
+        }
+
+        let mut missing_field = valid_manifest;
+        missing_field.as_object_mut().expect("manifest is an object").remove("sha256");
+        assert!(
+            validate_test_fork_manifest(missing_field, &config).is_err(),
+            "missing required checksum must be rejected"
+        );
+
+        let foreign_manifest_url = ForkUpdateConfig {
+            manifest_url: "https://evil.example/owner/repo/releases/latest/download/latest.json"
+                .to_string(),
+            release_id: 41,
+        };
+        assert!(validate_fork_update_config(&foreign_manifest_url).is_err());
+        let traversing_manifest_url = ForkUpdateConfig {
+            manifest_url: "https://github.com/example/../repo/releases/latest/download/latest.json"
+                .to_string(),
+            release_id: 41,
+        };
+        assert!(validate_fork_update_config(&traversing_manifest_url).is_err());
+    }
