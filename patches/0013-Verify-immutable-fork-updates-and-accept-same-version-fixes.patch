+async fn download_fork_release(
+    target_path: &Path,
+    release: &ForkReleaseAsset,
+    client: Arc<HttpClientWithUrl>,
+    on_progress: impl FnMut(Option<f32>),
+) -> Result<()> {
+    download_release(
+        target_path,
+        release.release.clone(),
+        client,
+        on_progress,
+    )
+    .await?;
+    verify_downloaded_fork_asset(target_path, release.size, &release.sha256).await
+}
+
+async fn verify_downloaded_fork_asset(
+    target_path: &Path,
+    expected_size: u64,
+    expected_sha256: &str,
+) -> Result<()> {
+    let metadata = fs::metadata(target_path).await?;
+    anyhow::ensure!(
+        metadata.len() == expected_size,
+        "downloaded fork asset size does not match manifest: expected {expected_size}, got {}",
+        metadata.len()
+    );
+
+    let mut file = File::open(target_path).await?;
+    let mut hasher = Sha256::new();
+    let mut downloaded_bytes = 0u64;
+    let mut buffer = [0u8; 8192];
+    loop {
+        let bytes_read = file.read(&mut buffer).await?;
+        if bytes_read == 0 {
+            break;
+        }
+        downloaded_bytes += bytes_read as u64;
+        hasher.update(&buffer[..bytes_read]);
+    }
+    anyhow::ensure!(
+        downloaded_bytes == expected_size,
+        "downloaded fork asset length changed while hashing: expected {expected_size}, got {downloaded_bytes}"
+    );
+    let actual_sha256 = format!("{:x}", hasher.finalize());
+    anyhow::ensure!(
+        actual_sha256 == expected_sha256,
+        "downloaded fork asset SHA-256 does not match manifest"
+    );
+    Ok(())
+}
